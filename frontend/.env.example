# API URL for decoupled frontend deployment (e.g. Vercel, Netlify).
# Point this to your backend service URL:
# VITE_API_URL=https://your-prepai-backend.onrender.com
#
# When running locally or when deployed as a unified full-stack service,
# leave this unset to automatically connect to the local/same-origin backend.
VITE_API_URL=http://localhost:5000
