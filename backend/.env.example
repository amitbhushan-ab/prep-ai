PORT=5000
# Comma-separated list of browser origins allowed to call the API, or * to allow any origin.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Required. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Optional: Set environment mode (production or development)
NODE_ENV=production
# Optional: Custom path for database file (e.g. for Docker volumes / persistent storage)
# DB_PATH=/app/data/db.json
